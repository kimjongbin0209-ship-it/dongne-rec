{
  "model": {
    "max_len": 100,
    "hidden": 256,
    "n_blocks": 2,
    "n_heads": 1,
    "dropout": 0.5
  },
  "train": {
    "windows": "all",
    "lr": 0.001,
    "batch_size": 128,
    "epochs": 200,
    "eval_every": 5,
    "patience": 4,
    "device": "auto"
  },
  "eval": {
    "n_sampled_negatives": 100,
    "seed": 0,
    "ks": [
      10
    ],
    "batch_size": 256,
    "primary": {
      "protocol": "E4",
      "metric": "ndcg@10"
    },
    "results_dir": "results",
    "itemknn": {
      "topk_neighbors": 100,
      "grid": {
        "last_n": [
          1,
          5,
          null
        ],
        "decay": [
          0.5,
          0.8,
          1.0
        ],
        "include_self": [
          true,
          false
        ]
      }
    }
  }
}